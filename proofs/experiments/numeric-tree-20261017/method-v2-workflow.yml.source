name: Numeric tree comparison

on:
  workflow_dispatch:
    inputs:
      baseline:
        description: Exact baseline revision to build
        required: true
        default: afdffdcfcbd61013f120de82411c0c4a6b2d1e0e
  pull_request:
    paths:
      - 'numeric-kernels.as.ts'
      - 'numeric.test.ts'
      - 'proofs/numeric-tree-*'
      - 'proofs/experiments/numeric-tree-20261017/**'
      - '.github/workflows/numeric-tree-performance.yml'

permissions:
  contents: read

jobs:
  compare:
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-24.04, ubuntu-24.04-arm]
    runs-on: ${{ matrix.os }}
    timeout-minutes: 30
    defaults:
      run:
        shell: bash --noprofile --norc -euo pipefail {0}
    env:
      BASE_DIR: ${{ github.workspace }}/.numeric-tree-base
      CANDIDATE_DIR: ${{ github.workspace }}
      EVIDENCE_DIR: ${{ github.workspace }}/proofs/results/numeric-tree-hosted
    steps:
      - name: Check out candidate
        uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - uses: oven-sh/setup-bun@v2
        with:
          bun-version: '1.4.2'
      - name: Install pinned dependencies
        run: bun install
      - name: Build candidate
        run: |
          mkdir -p "$EVIDENCE_DIR"
          bun run build:wasm
          bun run build:browser
          bun run build:types
      - name: Check types and test suite
        run: |
          bun run typecheck
          bun run typecheck:redux
          bun run typecheck:values
          bun run typecheck:geometry
          bunx tsc --noEmit -p tsconfig.numeric.json
          bun run test 2>&1 | tee "$EVIDENCE_DIR/tests.txt"
      - name: Check real workers on both runtimes
        run: |
          node proofs/numeric-tree-worker.mjs 2>&1 | tee "$EVIDENCE_DIR/node-worker.txt"
          bun proofs/numeric-tree-worker.mjs 2>&1 | tee "$EVIDENCE_DIR/bun-worker.txt"
      - name: Check out exact comparison base after candidate tests
        uses: actions/checkout@v4
        with:
          ref: ${{ github.event.pull_request.base.sha || inputs.baseline }}
          path: .numeric-tree-base
          persist-credentials: false
      - name: Build comparison base and check scalar bytes
        run: |
          ln -s "$GITHUB_WORKSPACE/node_modules" "$BASE_DIR/node_modules"
          cd "$BASE_DIR"
          bun run build:wasm
          bun run build:browser
          cmp numeric-kernels.wasm "$CANDIDATE_DIR/numeric-kernels.wasm"
      - name: Check fixed identical-source cohort
        id: aa
        continue-on-error: true
        env:
          SOURCE_DIR: ${{ github.workspace }}
          OUT_DIR: ${{ github.workspace }}/proofs/results/numeric-tree-hosted/aa
          NODE_BIN: node
          BUN_BIN: bun
        run: node proofs/numeric-tree-aa.mjs 2>&1 | tee "$EVIDENCE_DIR/aa-controller.txt"
      - name: Compare base and candidate on Node
        id: node
        continue-on-error: true
        env:
          PERF_GATE: '1'
          OUT_FILE: ${{ github.workspace }}/proofs/results/numeric-tree-hosted/node-full.json
        run: node proofs/numeric-tree-benchmark.mjs 2>&1 | tee "$EVIDENCE_DIR/node-full.txt"
      - name: Compare base and candidate on Bun
        id: bun
        continue-on-error: true
        env:
          PERF_GATE: '1'
          OUT_FILE: ${{ github.workspace }}/proofs/results/numeric-tree-hosted/bun-full.json
        run: bun proofs/numeric-tree-benchmark.mjs 2>&1 | tee "$EVIDENCE_DIR/bun-full.txt"
      - name: Install browser engines
        if: runner.arch == 'X64'
        run: bunx playwright install --with-deps chromium firefox webkit
      - name: Compare browser correctness and scalar fallback
        if: runner.arch == 'X64'
        env:
          OUT_FILE: ${{ github.workspace }}/proofs/results/numeric-tree-hosted/browsers.json
        run: node proofs/numeric-tree-browsers.mjs 2>&1 | tee "$EVIDENCE_DIR/browsers.txt"
      - name: Enforce every performance gate
        if: always()
        env:
          AA_RESULT: ${{ steps.aa.outcome }}
          NODE_RESULT: ${{ steps.node.outcome }}
          BUN_RESULT: ${{ steps.bun.outcome }}
        run: |
          test "$AA_RESULT" = success
          test "$NODE_RESULT" = success
          test "$BUN_RESULT" = success
      - name: Save all evidence, including failed gates
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: numeric-tree-${{ runner.arch }}-${{ github.sha }}
          path: proofs/results/numeric-tree-hosted/
          if-no-files-found: error
          retention-days: 30
