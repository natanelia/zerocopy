+  test('boolean get preserves exact values across leaves, forks, growth and attachments', async () => {
+    for (const size of [31, 32, 33, 1057]) {
+      const values = Array.from({ length: size }, (_, i) => i % 3 === 0);
+      const source = new SharedList('boolean').pushMany(values);
+      const fork = source.set(size - 1, !values[size - 1]).push(false);
+      const edited = [...values.slice(0, -1), !values[size - 1], false];
+      const shared = getWorkerData({ source, fork }, { copy: false });
+      for (const copy of [false, true]) {
+        const attached = await initWorker(getWorkerData({ source, fork }, { copy }));
+        const snapshots = [[source, values], [fork, edited], [attached.source, values], [attached.fork, edited]] as const;
+        for (const [snapshot, expected] of snapshots) expect(snapshot.get(0)).toBe(expected[0]);
+        shared.arenas[0].memory!.grow(1);
+        for (const [snapshot, expected] of snapshots) {
+          expect(Object.isFrozen(snapshot)).toBe(true);
+          for (let i = expected.length - 1; i >= 0; i--) expect(snapshot.get(i)).toBe(expected[i]);
+          for (let i = 0; i < expected.length; i++) expect(snapshot.get(i)).toBe(expected[i]);
+          for (const index of [-1, expected.length, NaN, Infinity, 1.5, '0']) {
+            expect(snapshot.get(index as number)).toBeUndefined();
+          }
+        }
+        expect(() => attached.source.push(true)).toThrow(/read-only/);
+        expect(() => attached.fork.set(0, false)).toThrow(/read-only/);
+      }
+    }
+  });
