+def _memory_diagnostics(observation, engine, critical):
+    """Pointwise component diagnostics cannot upgrade the fixed 22 decisions."""
+    if not observation["valid"]:
+        return {}, []
+    pairs, case = observation["pairs"], observation["case"]
