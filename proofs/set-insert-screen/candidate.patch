+    expect(set.size).toBe(expected.size);
+    const a = arenaOf(set), used = a.used, before = payload(a);
+    for (const value of values) { expect(set.add(value)).toBe(set); expect(set.has(value)).toBe(true); }
+    expect(a.used).toBe(used); unchanged(a, before);
