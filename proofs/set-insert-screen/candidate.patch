+  for (let i = 0; i < 1_000_000; i++) {
+    const value = `collision/${i}`, key = `s:${value}`;
+    let hash = 2166136261;
+    for (let j = 0; j < key.length; j++) hash = Math.imul(hash ^ key.charCodeAt(j), 16777619);
+    const previous = seen.get(hash);
+    if (previous !== undefined) return [previous, value];
+    seen.set(hash, value);
+  }
+  throw new Error('Bounded encoded-key collision setup found no pair');
