diff --git a/.github/workflows/hot-path-libraries.yml b/.github/workflows/hot-path-libraries.yml
new file mode 100644
index 0000000..957e41c
--- /dev/null
+++ b/.github/workflows/hot-path-libraries.yml
@@ -0,0 +1,41 @@
+name: Hot paths and library memory
+
+on:
+  push:
+    branches: [agent/immutable-performance-proof]
+    paths: ['**.ts', 'proofs/**', 'scripts/**', '.github/workflows/hot-path-libraries.yml']
+  pull_request:
+    paths: ['**.ts', 'proofs/**', 'scripts/**', '.github/workflows/hot-path-libraries.yml']
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  verify:
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '22'
+      - uses: oven-sh/setup-bun@v2
+        with:
+          bun-version: '1.4.2'
+      - run: bun install
+      - run: bun run build:wasm && bun run build:browser && bun run build:types
+      - run: bun run typecheck && bun run typecheck:redux
+      - run: bun run test
+      - run: bunx playwright install --with-deps chromium
+      - run: bun run test:browser
+      - name: Compare warm paths, cold paths, and retained memory
+        run: bash proofs/run-hot-path-evidence.sh
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: hot-path-library-evidence
+          path: |
+            proofs/results/hot-path/
+            proofs/results/cold-build/
+          retention-days: 90
